{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "Ukiyo: Verify Lens Profile",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/apply_lens_profile.py",
        "--verify-only"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ukiyo: Apply Lens Profile",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/apply_lens_profile.py"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ukiyo: Build",
      "type": "process",
      "command": "/opt/platformio/bin/pio",
      "args": [
        "run"
      ],
      "dependsOn": "Ukiyo: Verify Lens Profile",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ukiyo: Build Debug",
      "type": "process",
      "command": "/opt/platformio/bin/pio",
      "args": [
        "run",
        "-e",
        "seeed_xiao"
      ],
      "dependsOn": "Ukiyo: Verify Lens Profile",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ukiyo: Build Production",
      "type": "process",
      "command": "/opt/platformio/bin/pio",
      "args": [
        "run",
        "-e",
        "seeed_xiao_production"
      ],
      "dependsOn": "Ukiyo: Verify Lens Profile",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ukiyo: Upload",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/upload_with_retry.py",
        "--environment",
        "seeed_xiao",
        "--attempts",
        "3"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ukiyo: Upload Production",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/upload_with_retry.py",
        "--environment",
        "seeed_xiao_production",
        "--attempts",
        "3"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ukiyo: Monitor",
      "type": "process",
      "command": "/opt/platformio/bin/pio",
      "args": [
        "device",
        "monitor",
        "-p",
        "/dev/ttyACM0",
        "-b",
        "115200"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Ukiyo: Upload + Monitor",
      "type": "shell",
      "command": "python3 \"${workspaceFolder}/tools/upload_with_retry.py\" --environment seeed_xiao --attempts 3 && sleep 1 && /opt/platformio/bin/pio device monitor -p /dev/ttyACM0 -b 115200",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Ukiyo: Upload Production + Monitor",
      "type": "shell",
      "command": "python3 \"${workspaceFolder}/tools/upload_with_retry.py\" --environment seeed_xiao_production --attempts 3 && sleep 1 && /opt/platformio/bin/pio device monitor -p /dev/ttyACM0 -b 115200",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Ukiyo: Clean",
      "type": "process",
      "command": "/opt/platformio/bin/pio",
      "args": [
        "run",
        "-t",
        "clean"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
