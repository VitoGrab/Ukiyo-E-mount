{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "Ukiyo: Build & Upload",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/upload_with_retry.py",
        "--attempts",
        "3"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Ukiyo: Select Build Type",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/select_build_type.py",
        "${input:buildType}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    },
    {
      "label": "Ukiyo: Upload Lens Profile",
      "type": "process",
      "command": "/opt/platformio/bin/python",
      "args": [
        "${workspaceFolder}/tools/upload_lens_profile.py",
        "--port",
        "/dev/ttyACM0",
        "--select"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Ukiyo: Monitor",
      "type": "process",
      "command": "/opt/platformio/bin/pio",
      "args": [
        "device",
        "monitor",
        "-p",
        "/dev/ttyACM0",
        "-b",
        "115200"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "Ukiyo: Clean",
      "type": "process",
      "command": "/opt/platformio/bin/pio",
      "args": [
        "run",
        "-e",
        "seeed_xiao",
        "-e",
        "seeed_xiao_production",
        "-t",
        "clean"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      }
    }
  ],
  "inputs": [
    {
      "id": "buildType",
      "type": "pickString",
      "description": "Select the default firmware build type",
      "options": [
        {
          "label": "Debug (status LEDs enabled)",
          "value": "seeed_xiao"
        },
        {
          "label": "Production (status LEDs disabled)",
          "value": "seeed_xiao_production"
        }
      ]
    }
  ]
}
