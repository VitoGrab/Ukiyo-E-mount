{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "Ukiyo: Verify Reference Artifacts",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/apply_lens_profile.py",
        "--verify-only"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ukiyo: Regenerate Reference Artifacts",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/apply_lens_profile.py"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ukiyo: Build",
      "type": "process",
      "command": "/opt/platformio/bin/pio",
      "args": [
        "run"
      ],
      "dependsOn": "Ukiyo: Verify Reference Artifacts",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ukiyo: Build Production",
      "type": "process",
      "command": "/opt/platformio/bin/pio",
      "args": [
        "run",
        "-e",
        "seeed_xiao_production"
      ],
      "dependsOn": "Ukiyo: Verify Reference Artifacts",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ukiyo: Upload",
      "type": "process",
      "command": "/opt/platformio/bin/python",
      "args": [
        "${workspaceFolder}/tools/upload_with_retry.py",
        "--environment",
        "seeed_xiao",
        "--attempts",
        "3",
        "${input:cameraDetached}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ukiyo: Upload Production",
      "type": "process",
      "command": "/opt/platformio/bin/python",
      "args": [
        "${workspaceFolder}/tools/upload_with_retry.py",
        "--environment",
        "seeed_xiao_production",
        "--attempts",
        "3",
        "${input:cameraDetached}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Ukiyo: Monitor",
      "type": "process",
      "command": "/opt/platformio/bin/pio",
      "args": [
        "device",
        "monitor",
        "-p",
        "/dev/ttyACM0",
        "-b",
        "115200"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Ukiyo: Upload + Monitor",
      "type": "shell",
      "command": "/opt/platformio/bin/python \"${workspaceFolder}/tools/upload_with_retry.py\" --environment seeed_xiao --attempts 3 ${input:cameraDetached} && sleep 1 && /opt/platformio/bin/pio device monitor -p /dev/ttyACM0 -b 115200",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Ukiyo: Upload Production + Monitor",
      "type": "shell",
      "command": "/opt/platformio/bin/python \"${workspaceFolder}/tools/upload_with_retry.py\" --environment seeed_xiao_production --attempts 3 ${input:cameraDetached} && sleep 1 && /opt/platformio/bin/pio device monitor -p /dev/ttyACM0 -b 115200",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Ukiyo: Clean",
      "type": "shell",
      "command": "/opt/platformio/bin/pio run -e seeed_xiao -t clean && /opt/platformio/bin/pio run -e seeed_xiao_production -t clean",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "cameraDetached",
      "type": "pickString",
      "description": "Physically disconnect the camera before updating firmware.",
      "options": [
        {
          "label": "Cancel (camera still connected)",
          "value": "--cancel"
        },
        {
          "label": "Camera physically disconnected",
          "value": "--detached"
        }
      ],
      "default": "--cancel"
    }
  ]
}
